{
  "name": "processo_seletivo_inteligente",
  "private": true,
  "scripts": {
    "build": "npm run build -w @repo/types && npm run build -w backend && npm run build -w admin-web",
    "dev": "npm run start:dev -w backend & npm run dev -w admin-web",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "npm run check-types --workspaces --if-present"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
