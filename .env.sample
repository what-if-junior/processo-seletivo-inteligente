# -----------------------------------------------------------------------------
# Postgres (usado pelo serviço postgres + backend)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=processo_seletivo
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASS=postgres
DATABASE_NAME=processo_seletivo

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
PORT=5005
JWT_SECRET_TO_SIGN=your-jwt-secret-here
SECRET_OR_KEY=your-jwt-secret-here
# Origens CORS permitidas (separadas por vírgula; admin :3000; candidate PWA :3001)
# Local:  http://localhost:3000,http://localhost:3001
WEB_ORIGIN=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# URL interna do backend na rede Docker (server-side/SSR)
BACKEND_SERVICE_URL=http://backend:5005
# URL pública do backend acessível pelo navegador; INLINADA no bundle em build
NEXT_PUBLIC_API_URL=http://localhost:5005

# -----------------------------------------------------------------------------
# Notificações — delivery (W31-08/09)
# -----------------------------------------------------------------------------
# Endpoint HTTP do n8n que ENVIA e-mail (SMTP real fica no n8n). Sem ele, as
# intenções de e-mail ficam adiadas (adiado_smtp) até a ops configurar.
N8N_EMAIL_ENDPOINT=

# Assistente W34 — webhooks n8n para chat e ingestão RAG
# Configure com as credenciais Basic Auth criadas para estes webhooks.
N8N_BASE_URL=
N8N_CHAT_URL=/webhook/chat
N8N_INGEST_URL=/webhook/ingest
N8N_USER=
N8N_PASSWORD=

# Chaves VAPID para Web Push (W31-09). Gere com: npx web-push generate-vapid-keys
# Sem as chaves, o push fica desativado (fail-closed): assinaturas são salvas,
# mas nenhum aviso é enviado.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Assunto (mailto:) obrigatório pelo padrão VAPID
VAPID_SUBJECT=mailto:contato@ifb.edu.br
# Chave pública exposta à PWA (safe para inlinear no bundle)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Deploy (docker compose / GHCR)
# -----------------------------------------------------------------------------
REGISTRY=ghcr.io/what-if-junior/processo-seletivo-inteligente
IMAGE_TAG=latest
# Porta pública do backend no host (backend permanece público em :5005)
BACKEND_PORT=5005

# -----------------------------------------------------------------------------
# pgAdmin (compose profile: tools)
# -----------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
